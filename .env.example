# Postgres used by the app (runtime), drizzle-kit and the scripts
DATABASE_URL=postgres://invictuscamp:invictuscamp@localhost:5436/invictuscamp
NUXT_DATABASE_URL=postgres://invictuscamp:invictuscamp@localhost:5436/invictuscamp
# Only for the first start on a shared Postgres server (creates role and database), then remove it.
# DATABASE_ADMIN_URL=postgres://<superuser>:<password>@<host>:5432/postgres

# Seals the session cookie (openssl rand -base64 32)
NUXT_APP_SECRET=change-me-openssl-rand-base64-32

# Public address of the app, used in the links of the emails
NUXT_APP_URL=http://localhost:3080

# Resend. Without a key emails are not sent: they are recorded in the email log as "simulata"
# and, in development, the links of access emails are printed in the server console.
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM="Invictus Camp <noreply@invictuscamp.it>"
NUXT_EMAIL_REPLY_TO=

# Uploaded files (filesystem). In production: a persistent volume.
NUXT_UPLOADS_DIR=./.data/uploads

# Database tests (dropped and recreated at every run)
TEST_DATABASE_URL=postgres://invictuscamp:invictuscamp@localhost:5436/invictuscamp_test
